{
  "expo": {
    "name": "GFreeWay",
    "slug": "safeeats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gfreewayicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/gfreewayicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexstephens.safeeats",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lexstephens.safeeats"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "MAPBOX_ACCESS_TOKEN": "YOUR_MAPBOX_TOKEN_HERE",
      "eas": {
        "projectId": "8a266c8f-bf6d-4252-b4f9-2aaf50cf1654"
      }
    },
    "owner": "lexstephens",
    "plugins": [
  [
    "@rnmapbox/maps",
    {
      "RNMapboxMapsVersion": "10.17.0"
    }
  ]
]
  }
} 
